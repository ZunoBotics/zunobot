<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".MainActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Status Text -->
        <TextView
            android:id="@+id/statusText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Not Connected"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center"
            android:padding="12dp"
            android:background="@drawable/rounded_background"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Movement Section -->
        <TextView
            android:id="@+id/movementLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Movement"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toBottomOf="@id/statusText"
            app:layout_constraintStart_toStartOf="parent" />

        <Button
            android:id="@+id/forwardBtn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="⬆️ Forward"
            android:textSize="16sp"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/movementLabel"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <Button
            android:id="@+id/leftBtn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="⬅️ Left"
            android:textSize="16sp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="4dp"
            app:layout_constraintTop_toBottomOf="@id/forwardBtn"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/rightBtn" />

        <Button
            android:id="@+id/rightBtn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="➡️ Right"
            android:textSize="16sp"
            android:layout_marginTop="8dp"
            android:layout_marginStart="4dp"
            app:layout_constraintTop_toBottomOf="@id/forwardBtn"
            app:layout_constraintStart_toEndOf="@id/leftBtn"
            app:layout_constraintEnd_toEndOf="parent" />

        <Button
            android:id="@+id/backwardBtn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="⬇️ Backward"
            android:textSize="16sp"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/leftBtn"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Rotation Section -->
        <TextView
            android:id="@+id/rotationLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Rotation"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toBottomOf="@id/backwardBtn"
            app:layout_constraintStart_toStartOf="parent" />

        <Button
            android:id="@+id/turnLeftBtn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="↶ Turn Left"
            android:textSize="16sp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="4dp"
            app:layout_constraintTop_toBottomOf="@id/rotationLabel"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/turnRightBtn" />

        <Button
            android:id="@+id/turnRightBtn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="↷ Turn Right"
            android:textSize="16sp"
            android:layout_marginTop="8dp"
            android:layout_marginStart="4dp"
            app:layout_constraintTop_toBottomOf="@id/rotationLabel"
            app:layout_constraintStart_toEndOf="@id/turnLeftBtn"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Gestures Section -->
        <TextView
            android:id="@+id/gesturesLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Gestures &amp; Audio"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toBottomOf="@id/turnLeftBtn"
            app:layout_constraintStart_toStartOf="parent" />

        <Button
            android:id="@+id/lookAroundBtn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="👀 Look Around"
            android:textSize="16sp"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/gesturesLabel"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <Button
            android:id="@+id/greetingBtn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="🗣️ Play Greeting"
            android:textSize="16sp"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/lookAroundBtn"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Detection Section -->
        <TextView
            android:id="@+id/detectionLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Person Detection"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toBottomOf="@id/greetingBtn"
            app:layout_constraintStart_toStartOf="parent" />

        <Button
            android:id="@+id/detectionStartBtn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="▶️ Start Detection"
            android:textSize="16sp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="4dp"
            app:layout_constraintTop_toBottomOf="@id/detectionLabel"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/detectionStopBtn" />

        <Button
            android:id="@+id/detectionStopBtn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="⏹️ Stop Detection"
            android:textSize="16sp"
            android:layout_marginTop="8dp"
            android:layout_marginStart="4dp"
            app:layout_constraintTop_toBottomOf="@id/detectionLabel"
            app:layout_constraintStart_toEndOf="@id/detectionStartBtn"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Emergency Stop -->
        <Button
            android:id="@+id/stopBtn"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:text="🛑 EMERGENCY STOP"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="24dp"
            android:backgroundTint="@color/stop_red"
            app:layout_constraintTop_toBottomOf="@id/detectionStartBtn"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
